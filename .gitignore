# Android build output: APK-и по 150+ МБ, у git їм не місце
/Build/

# APK і відео завеликі для git (ліміт GitHub — 100 МБ на файл);
# вони прикріплені до GitHub Release замість репозиторію
/Delivery/*.apk
/Delivery/*.mp4

# Кеш автозбережень Premiere - не робота, а бекапи редактора
/Premier/Adobe Premiere Pro Auto-Save/

# Особисті нотатки і портфоліо - не для клієнта
/Documentation/Personal/
